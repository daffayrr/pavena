@page "/"
@inject IToastService ToastService

<PageTitle>Pavena — Linimasa Riset & Kolaborasi Ilmiah</PageTitle>

<div class="pv-container" style="max-width: 1040px;">
    <div style="display: grid; grid-template-columns: 1fr 300px; gap: 1.5rem; align-items: start;">
        
        <!-- Left Column: Main Feed -->
        <div>
            <!-- Create Post Card -->
            <div class="pv-card" style="margin-bottom: 1.5rem; padding: 1.25rem;">
                <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <PvAvatar Name="Dr. Marie Curie" Size="md" Status="online" />
                    <textarea class="pv-textarea"
                              placeholder="Bagikan hipotesis, temuan eksperimen, atau publikasi terkini..."
                              rows="2"
                              @bind="_postContent"
                              style="border-color: transparent; background-color: var(--pv-color-surface-hover); font-size: 0.9375rem;"></textarea>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--pv-color-border); padding-top: 0.75rem;">
                    <div style="display: flex; gap: 0.5rem;">
                        <PvButton Variant="ghost" Size="sm">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                            </svg>
                            <span>Lampiran PDF/Data</span>
                        </PvButton>
                        <PvButton Variant="ghost" Size="sm">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span>DOI</span>
                        </PvButton>
                    </div>

                    <div style="display: flex; gap: 0.75rem; align-items: center;">
                        <PvBadge Variant="neutral">Publik</PvBadge>
                        <PvButton Variant="primary" Size="sm" OnClick="SubmitPost" Disabled="@string.IsNullOrWhiteSpace(_postContent)">
                            Publikasikan
                        </PvButton>
                    </div>
                </div>
            </div>

            <!-- Feed Items -->
            <div class="pv-card is-hoverable" style="margin-bottom: 1.5rem;">
                <div class="pv-card-header">
                    <div style="display: flex; gap: 0.75rem; align-items: center;">
                        <PvAvatar Name="Prof. Albert Einstein" Size="md" Status="online" />
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <strong style="font-size: 0.9375rem; color: var(--pv-color-text);">Prof. Albert Einstein</strong>
                                <PvBadge Variant="secondary" ShowDot="true">Fisika Teoretis</PvBadge>
                            </div>
                            <div style="font-size: 0.75rem; color: var(--pv-color-text-muted);">Institute for Advanced Study, Princeton • 2 jam yang lalu</div>
                        </div>
                    </div>
                    <PvBadge Variant="primary">Publik</PvBadge>
                </div>

                <div class="pv-card-body">
                    <p style="font-size: 0.9375rem; line-height: 1.6; margin-bottom: 0.75rem;">
                        Dalam peninjauan ulang tensor kelengkungan Riemann untuk persamaan medan gravitasi, kami menemukan solusi batas baru yang menjembatani konsistensi metrik Schwarzschild pada koordinat isotropik.
                    </p>
                    <div style="padding: 0.75rem 1rem; background-color: var(--pv-color-surface-hover); border-left: 3px solid var(--pv-color-secondary); border-radius: 0 var(--pv-radius-md) var(--pv-radius-md) 0; font-family: var(--pv-font-mono); font-size: 0.8125rem; color: var(--pv-color-text);">
                        R_μν - 1/2 g_μν R + Λ g_μν = (8πG / c⁴) T_μν
                    </div>
                </div>

                <div class="pv-card-footer">
                    <div style="display: flex; gap: 0.5rem; width: 100%;">
                        <PvButton Variant="ghost" Size="sm" OnClick='@(() => ToastService.Info("Menandai apresiasi ilmiah."))'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                            </svg>
                            <span>Apresiasi (48)</span>
                        </PvButton>
                        <PvButton Variant="ghost" Size="sm" OnClick='@(() => ToastService.Info("Membuka utas diskusi akademis."))'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span>Diskusi (16)</span>
                        </PvButton>
                        <PvButton Variant="ghost" Size="sm" Style="margin-left: auto;" OnClick='@(() => ToastService.Success("Tautan sitasi disalin."))'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="18" cy="5" r="3"></circle>
                                <circle cx="6" cy="12" r="3"></circle>
                                <circle cx="18" cy="19" r="3"></circle>
                                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                            </svg>
                            <span>Sitasi & Bagikan</span>
                        </PvButton>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Rail: Academic Recommendations -->
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <!-- Profile Summary Card -->
            <div class="pv-card" style="padding: 1.25rem; text-align: center;">
                <div style="display: flex; justify-content: center; margin-bottom: 0.75rem;">
                    <PvAvatar Name="Dr. Marie Curie" Size="lg" Status="online" />
                </div>
                <h4 style="font-size: 1rem; margin-bottom: 2px;">Dr. Marie Curie</h4>
                <div style="font-size: 0.75rem; color: var(--pv-color-text-muted); margin-bottom: 0.75rem;">
                    Laboratoire Curie • Fisika & Kimia
                </div>
                <div style="display: flex; justify-content: space-around; border-top: 1px solid var(--pv-color-border); padding-top: 0.75rem; font-size: 0.75rem;">
                    <div>
                        <div style="font-weight: 700; color: var(--pv-color-primary); font-size: 1rem;">128</div>
                        <div style="color: var(--pv-color-text-muted);">Kolega</div>
                    </div>
                    <div>
                        <div style="font-weight: 700; color: var(--pv-color-primary); font-size: 1rem;">42</div>
                        <div style="color: var(--pv-color-text-muted);">Publikasi</div>
                    </div>
                    <div>
                        <div style="font-weight: 700; color: var(--pv-color-primary); font-size: 1rem;">1,840</div>
                        <div style="color: var(--pv-color-text-muted);">Sitasi</div>
                    </div>
                </div>
            </div>

            <!-- Suggested Scholars -->
            <div class="pv-card" style="padding: 1.25rem;">
                <h4 style="font-size: 0.9375rem; margin-bottom: 1rem; color: var(--pv-color-text);">Kolega Rekomendasi</h4>
                
                <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <PvAvatar Name="Niels Bohr" Size="sm" />
                            <div>
                                <div style="font-size: 0.8125rem; font-weight: 600;">Niels Bohr</div>
                                <div style="font-size: 0.6875rem; color: var(--pv-color-text-muted);">Universitas Kopenhagen</div>
                            </div>
                        </div>
                        <PvButton Variant="outline" Size="sm" OnClick='@(() => ToastService.Success("Permintaan koneksi terkirim ke Niels Bohr."))'>
                            Koneksi
                        </PvButton>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <PvAvatar Name="Rosalind Franklin" Size="sm" />
                            <div>
                                <div style="font-size: 0.8125rem; font-weight: 600;">Rosalind Franklin</div>
                                <div style="font-size: 0.6875rem; color: var(--pv-color-text-muted);">King's College London</div>
                            </div>
                        </div>
                        <PvButton Variant="outline" Size="sm" OnClick='@(() => ToastService.Success("Permintaan koneksi terkirim ke Rosalind Franklin."))'>
                            Koneksi
                        </PvButton>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private string? _postContent;

    private void SubmitPost()
    {
        if (!string.IsNullOrWhiteSpace(_postContent))
        {
            ToastService.Success("Catatan riset Anda telah berhasil diterbitkan ke linimasa.");
            _postContent = string.Empty;
        }
    }
}
