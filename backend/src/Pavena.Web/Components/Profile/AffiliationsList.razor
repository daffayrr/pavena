@namespace Pavena.Web.Components.Profile
@using Pavena.Application.Identity.DTOs
@using Pavena.Web.Components.UI

<div class="pv-profile-section">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--pv-space-4);">
        <h3 style="font-size: 1.125rem; font-weight: 600; color: var(--pv-color-text); margin: 0; display: flex; align-items: center; gap: 8px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pv-color-primary);">
                <path d="M3 21h18"></path>
                <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path>
                <path d="M9 9h1"></path>
                <path d="M9 13h1"></path>
                <path d="M9 17h1"></path>
                <path d="M14 9h1"></path>
                <path d="M14 13h1"></path>
                <path d="M14 17h1"></path>
            </svg>
            <span>Afiliasi Institusi & Lembaga</span>
        </h3>
    </div>

    @if (Affiliations == null || !Affiliations.Any())
    {
        <PvEmptyState Title="Belum ada afiliasi terdaftar"
                      Description="Afiliasi universitas, laboratorium, atau pusat riset yang terhubung akan muncul di sini." />
    }
    else
    {
        <div class="pv-academic-list">
            @foreach (var aff in Affiliations)
            {
                <div class="pv-academic-item">
                    <div class="pv-academic-item-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                            <path d="M2 17l10 5 10-5"></path>
                            <path d="M2 12l10 5 10-5"></path>
                        </svg>
                    </div>
                    <div class="pv-academic-item-content">
                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
                            <div class="pv-academic-item-title">@aff.OrganizationName</div>
                            @if (aff.IsVerified)
                            {
                                <span class="pv-pill-verified" title="Organisasi dan status keanggotaan telah diverifikasi oleh otoritas lembaga">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                    </svg>
                                    <span>Afiliasi Terverifikasi</span>
                                </span>
                            }
                            else
                            {
                                <span class="pv-pill-claimed" title="Klaim mandiri peneliti (menunggu konfirmasi domain/organisasi)">
                                    <span>Klaim Mandiri</span>
                                </span>
                            }
                        </div>

                        <div class="pv-academic-item-subtitle" style="color: var(--pv-color-text-muted);">
                            <strong>@(aff.Title ?? aff.Role)</strong>
                            @if (!string.IsNullOrWhiteSpace(aff.Department))
                            {
                                <span> · @aff.Department</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<AffiliationDto>? Affiliations { get; set; }
}
