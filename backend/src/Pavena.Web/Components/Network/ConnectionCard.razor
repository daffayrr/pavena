@namespace Pavena.Web.Components.Network
@using Pavena.Application.Social.DTOs
@using Pavena.Web.Components.UI

<div class="pv-connection-card">
    <div class="pv-connection-info">
        <PvAvatar Name="@Connection.DisplayName" ImageUrl="@Connection.AvatarUrl" Size="lg" Status="online" />
        <div class="pv-connection-details">
            <h4>
                <a href="@ProfileUrl" style="color: var(--pv-color-text); text-decoration: none;">
                    @Connection.DisplayName
                </a>
            </h4>
            @if (!string.IsNullOrWhiteSpace(Connection.Headline))
            {
                <p>@Connection.Headline</p>
            }
            <div class="pv-connection-time">
                Terhubung sejak @Connection.ConnectedAtUtc.ToString("dd MMMM yyyy")
            </div>
        </div>
    </div>

    <div class="pv-connection-actions">
        <a href="@ProfileUrl" class="pv-btn pv-btn-outline pv-btn-sm" style="text-decoration: none;">
            <span>Lihat Profil</span>
        </a>
        <PvButton Variant="ghost" Size="sm" Class="is-danger" OnClick="() => showConfirm = true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span>Putuskan Koneksi</span>
        </PvButton>
    </div>
</div>

<PvModal IsOpen="@showConfirm" IsOpenChanged="@(v => showConfirm = v)" Title="Konfirmasi Putuskan Koneksi" MaxWidth="440px">
    <ChildContent>
        <p style="font-size: 0.875rem; color: var(--pv-color-text); line-height: 1.5; margin: 0;">
            Apakah Anda yakin ingin memutuskan hubungan kolegial dengan <strong>@Connection.DisplayName</strong>? Anda tidak akan lagi melihat postingan berstatus khusus koneksi dari peneliti ini.
        </p>
    </ChildContent>
    <Footer>
        <PvButton Variant="ghost" OnClick="() => showConfirm = false">Batal</PvButton>
        <PvButton Variant="primary" Class="is-danger" IsLoading="@isRemoving" OnClick="HandleConfirmRemove">
            <span>Ya, Putuskan Koneksi</span>
        </PvButton>
    </Footer>
</PvModal>

@code {
    [Parameter] public ConnectionUserDto Connection { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnRemove { get; set; }

    private bool showConfirm = false;
    private bool isRemoving = false;

    private string ProfileUrl => !string.IsNullOrWhiteSpace(Connection.Username)
        ? $"/scholars/{Connection.Username}"
        : $"/scholars/{Connection.UserId}";

    private async Task HandleConfirmRemove()
    {
        isRemoving = true;
        try
        {
            await OnRemove.InvokeAsync(Connection.UserId);
            showConfirm = false;
        }
        finally
        {
            isRemoving = false;
        }
    }
}
