@code {
    [Parameter] public Guid Id { get; set; }

    private ProjectDetailDto? _project;
    private IReadOnlyList<ProjectActivityLogDto>? _timelineLogs;
    private bool _isLoading = true;
    private string _currentTab = "overview";

    // Modals
    private bool _showStageModal = false;
    private string _selectedNewStage = "Proposal";

    private bool _showStatusModal = false;
    private string _selectedNewStatus = "Active";
    private string _statusChangeReason = "";

    private bool _showInviteModal = false;
    private string _inviteUserId = "";
    private string _inviteRole = "Researcher";
    private string _inviteMessage = "";

    private bool _showMilestoneModal = false;
    private string _newMilestoneTitle = "";
    private DateTime _newMilestoneDate = DateTime.Today.AddMonths(1);
    private string _newMilestoneDesc = "";

    private bool _showTaskModal = false;
    private string _newTaskTitle = "";
    private string _newTaskPriority = "Medium";
    private string _newTaskDesc = "";

    protected override async Task OnParametersSetAsync()
    {
        await LoadProjectAsync();
    }

    private async Task LoadProjectAsync()
    {
        _isLoading = true;
        try
        {
            _project = await ProjectClient.GetProjectByIdAsync(Id);
            if (_project != null)
            {
                _selectedNewStage = _project.Stage;
                _selectedNewStatus = _project.Status;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal memuat ruang kerja riset: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadTimelineAsync()
    {
        _currentTab = "timeline";
        if (_timelineLogs == null)
        {
            try
            {
                _timelineLogs = await ProjectClient.GetActivityTimelineAsync(Id);
            }
            catch (Exception ex)
            {
                ToastService.ShowError("Gagal memuat riwayat: " + ex.Message);
            }
        }
    }

    private async Task AdvanceStageAsync()
    {
        try
        {
            var updated = await ProjectClient.AdvanceStageAsync(Id, new AdvanceProjectStageRequest(_selectedNewStage));
            if (updated != null)
            {
                _project = updated;
                _showStageModal = false;
                ToastService.ShowSuccess("Tahapan riset berhasil dimajukan!");
                _timelineLogs = null;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal memajukan tahapan: " + ex.Message);
        }
    }

    private async Task UpdateStatusAsync()
    {
        try
        {
            var updated = await ProjectClient.UpdateStatusAsync(Id, new UpdateProjectStatusRequest(_selectedNewStatus, _statusChangeReason));
            if (updated != null)
            {
                _project = updated;
                _showStatusModal = false;
                ToastService.ShowSuccess("Status proyek berhasil diperbarui!");
                _timelineLogs = null;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal memperbarui status: " + ex.Message);
        }
    }

    private async Task InviteMemberAsync()
    {
        if (!Guid.TryParse(_inviteUserId, out var targetGuid))
        {
            ToastService.ShowError("User ID tidak valid. Harap gunakan GUID yang sah.");
            return;
        }

        try
        {
            var inv = await ProjectClient.InviteMemberAsync(Id, new InviteMemberRequest(targetGuid, _inviteRole, _inviteMessage));
            if (inv != null)
            {
                ToastService.ShowSuccess("Undangan kolaborasi berhasil dikirim!");
                _showInviteModal = false;
                _inviteUserId = "";
                _inviteMessage = "";
                await LoadProjectAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal mengundang anggota: " + ex.Message);
        }
    }

    private async Task RemoveMemberAsync(Guid targetUserId)
    {
        try
        {
            var success = await ProjectClient.RemoveMemberAsync(Id, targetUserId);
            if (success)
            {
                ToastService.ShowSuccess("Anggota tim berhasil dikeluarkan.");
                await LoadProjectAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal mengeluarkan anggota: " + ex.Message);
        }
    }

    private async Task PromptTransferLeadership(Guid targetUserId, string targetName)
    {
        try
        {
            var success = await ProjectClient.TransferLeadershipAsync(Id, new TransferLeadershipRequest(targetUserId));
            if (success)
            {
                ToastService.ShowSuccess($"Kepemimpinan proyek berhasil dialihkan kepada {targetName}.");
                await LoadProjectAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal mengalihkan kepemimpinan: " + ex.Message);
        }
    }

    private async Task CreateMilestoneAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMilestoneTitle))
        {
            ToastService.ShowError("Judul milestone wajib diisi.");
            return;
        }

        try
        {
            var ms = await ProjectClient.CreateMilestoneAsync(Id, new CreateMilestoneRequest(_newMilestoneTitle.Trim(), _newMilestoneDate, _newMilestoneDesc.Trim()));
            if (ms != null)
            {
                ToastService.ShowSuccess("Milestone berhasil ditambahkan!");
                _showMilestoneModal = false;
                _newMilestoneTitle = "";
                _newMilestoneDesc = "";
                await LoadProjectAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal membuat milestone: " + ex.Message);
        }
    }

    private async Task CreateTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle))
        {
            ToastService.ShowError("Judul tugas riset wajib diisi.");
            return;
        }

        try
        {
            var task = await ProjectClient.CreateTaskAsync(Id, new CreateTaskRequest(_newTaskTitle.Trim(), _newTaskDesc.Trim(), null, _newTaskPriority, null, null));
            if (task != null)
            {
                ToastService.ShowSuccess("Tugas riset berhasil dibuat!");
                _showTaskModal = false;
                _newTaskTitle = "";
                _newTaskDesc = "";
                await LoadProjectAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal membuat tugas: " + ex.Message);
        }
    }
}
