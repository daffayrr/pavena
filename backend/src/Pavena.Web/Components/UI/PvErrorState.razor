<div class="pv-error-state @Class" role="alert">
    <div class="pv-error-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
    </div>

    <h4 class="pv-error-title">@Title</h4>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="pv-error-desc">@Message</p>
    }

    @if (OnRetry.HasDelegate)
    {
        <PvButton Variant="danger" Size="sm" OnClick="OnRetry">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span>@RetryLabel</span>
        </PvButton>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Gagal Memuat Data";
    [Parameter] public string? Message { get; set; } = "Terjadi kendala teknis saat menyinkronkan data ilmiah. Silakan coba lagi.";
    [Parameter] public string RetryLabel { get; set; } = "Coba Lagi";
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public string? Class { get; set; }
}
