# ==============================================================================
# Pavena Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or configure corresponding appsettings / environment variables.
# Do NOT commit actual production secrets to source control.

# ------------------------------------------------------------------------------
# Core Runtime Environment
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
DOTNET_PRINT_TELEMETRY_MESSAGE=false

# ------------------------------------------------------------------------------
# Database Configuration (Dual Provider Support)
# ------------------------------------------------------------------------------
# Options: 'MySQL' (default initial baseline) or 'PostgreSQL' (target deployment)
DatabaseProvider=MySQL

# Option A: MySQL Connection (Port 3306)
ConnectionStrings__DefaultConnection="Server=localhost;Port=3306;Database=pavena_db;User=root;Password=abc_123;CharSet=utf8mb4;"

# Option B: PostgreSQL Connection (Port 5432) - Uncomment to switch to Postgres:
# DatabaseProvider=PostgreSQL
# ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=pavena_db;Username=pavena_user;Password=pavena_secure_password;Include Error Detail=true;"

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Secret must be at least 32 characters (256 bits) for HMAC-SHA256
Jwt__Secret="pavena_super_secret_dev_key_must_be_at_least_32_characters_long_123456"
Jwt__Issuer="Pavena"
Jwt__Audience="Pavena"
Jwt__ExpirationMinutes=120
Jwt__RefreshTokenExpirationDays=7

# ------------------------------------------------------------------------------
# Storage Configuration (Private Object Storage)
# ------------------------------------------------------------------------------
# Filesystem path for private manuscript, avatar, and challenge attachments
Storage__BasePath="./App_Data/storage"
Storage__SignedTokenSecret="PavenaSuperSecretKeyForStorageSignatures2026!#$DefaultTestingKey"
Storage__MaxFileSizeBytes=26214400

# ------------------------------------------------------------------------------
# LaTeX Sandbox Execution
# ------------------------------------------------------------------------------
# Path to TeX Live / MikTeX executable directory (or leave default if in system PATH)
Latex__Compiler="pdflatex"
Latex__TimeoutSeconds=30
Latex__MaxScratchSizeBytes=52428800

# ------------------------------------------------------------------------------
# Platform Superadmin Bootstrap (Startup Seeding)
# ------------------------------------------------------------------------------
SUPERADMIN_EMAIL="superadmin@pavena.local"
SUPERADMIN_PASSWORD="PavenaAdmin#2026"

# ------------------------------------------------------------------------------
# Frontend & API Endpoints
# ------------------------------------------------------------------------------
# Backend API endpoints: http://localhost:5181, https://localhost:7158
# Blazor Web App endpoints: http://localhost:5000, https://localhost:5001
ApiBaseUrl="http://localhost:5181/"
