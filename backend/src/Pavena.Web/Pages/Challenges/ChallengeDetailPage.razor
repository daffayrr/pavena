@page "/challenges/{Id:guid}"
@rendermode InteractiveServer

@using System.Security.Cryptography
@using System.Text
@using Pavena.Application.Challenges.DTOs
@using Pavena.Domain.Enums
@using Pavena.Web.Components.Common
@using Pavena.Web.Services.Challenges
@using Pavena.Web.Services.Toast

@inject IChallengeClient ChallengeClient
@inject IToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>@( _challenge?.Title ?? "Detail Tantangan Riset" ) — Pavena</PageTitle>

<div class="pv-container" style="max-width: 1050px; padding: 2rem 1rem;">
    <!-- Breadcrumb -->
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; font-size: 0.875rem;">
        <a href="/challenges" style="color: var(--pv-color-text-muted); text-decoration: none;">Tantangan Industri</a>
        <span style="color: var(--pv-color-border);">/</span>
        <span style="color: var(--pv-color-text); font-weight: 500;">Detail Tantangan</span>
    </div>

    @if (_isLoading)
    {
        <div style="text-align: center; padding: 5rem 1rem;">
            <div class="pv-spinner" style="margin-bottom: 1rem;"></div>
            <p style="color: var(--pv-color-text-muted);">Memuat informasi tantangan...</p>
        </div>
    }
    else if (_challenge == null)
    {
        <div class="pv-card" style="text-align: center; padding: 4rem 2rem;">
            <h3 style="color: var(--pv-color-text); margin-bottom: 0.5rem;">Tantangan Riset Tidak Ditemukan</h3>
            <p style="color: var(--pv-color-text-muted); margin-bottom: 1.5rem;">
                Tantangan ini mungkin belum dipublikasikan atau akses Anda dibatasi oleh kebijakan privasi.
            </p>
            <a href="/challenges" class="pv-btn pv-btn-primary">Kembali ke Daftar Tantangan</a>
        </div>
    }
    else
    {
        <!-- Main Challenge Card Header -->
        <div class="pv-card" style="padding: 2rem; margin-bottom: 2rem; border-left: 5px solid var(--pv-color-primary);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem;">
                <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <span style="font-weight: 700; color: var(--pv-color-primary); font-size: 0.9375rem;">
                            @_challenge.OrganizationName
                        </span>
                        <span style="color: var(--pv-color-border);">•</span>
                        <span style="color: var(--pv-color-text-muted); font-size: 0.8125rem;">
                            Dipublikasikan @( _challenge.PublishedAtUtc.HasValue ? _challenge.PublishedAtUtc.Value.ToString("dd MMMM yyyy") : "Draf" )
                        </span>
                    </div>
                    <h1 style="font-size: 1.875rem; font-weight: 800; color: var(--pv-color-text); margin: 0 0 0.75rem 0; line-height: 1.3;">
                        @_challenge.Title
                    </h1>
                </div>

                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                    @if (_challenge.Status == ChallengeStatus.OpenForProposals)
                    {
                        <span class="pv-badge pv-badge-success" style="font-weight: 600;">Menerima Proposal</span>
                    }
                    else
                    {
                        <span class="pv-badge pv-badge-secondary">@_challenge.Status</span>
                    }

                    <span class="pv-badge pv-badge-ghost">@_challenge.Eligibility</span>
                </div>
            </div>

            <p style="color: var(--pv-color-text); font-size: 1.0625rem; line-height: 1.6; margin: 0 0 1.5rem 0;">
                @_challenge.Summary
            </p>

            <!-- Metrics bar -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; background: var(--pv-color-surface); padding: 1.25rem; border-radius: 8px; border: 1px solid var(--pv-color-border);">
                <div>
                    <span style="display: block; font-size: 0.75rem; color: var(--pv-color-text-muted); text-transform: uppercase; font-weight: 600;">Alokasi Pendanaan</span>
                    <strong style="font-size: 1.125rem; color: var(--pv-color-primary);">
                        @FormatBudget(_challenge.Currency, _challenge.MinBudget, _challenge.MaxBudget)
                    </strong>
                </div>

                <div>
                    <span style="display: block; font-size: 0.75rem; color: var(--pv-color-text-muted); text-transform: uppercase; font-weight: 600;">Batas Waktu Pengajuan</span>
                    <strong style="font-size: 1.125rem; color: var(--pv-color-text);">
                        @_challenge.SubmissionDeadlineUtc.ToString("dd MMM yyyy")
                    </strong>
                </div>

                <div>
                    <span style="display: block; font-size: 0.75rem; color: var(--pv-color-text-muted); text-transform: uppercase; font-weight: 600;">Status Kelayakan Anda</span>
                    <div style="display: flex; align-items: center; gap: 0.375rem; margin-top: 0.25rem;">
                        @if (_eligibilityResult != null && _eligibilityResult.IsEligible)
                        {
                            <span style="color: var(--pv-color-success); font-weight: 600; font-size: 0.875rem;">✓ Memenuhi Syarat</span>
                        }
                        else
                        {
                            <span style="color: var(--pv-color-warning); font-weight: 600; font-size: 0.875rem;">! Terbuka Evaluasi</span>
                        }
                    </div>
                </div>

                <div>
                    <span style="display: block; font-size: 0.75rem; color: var(--pv-color-text-muted); text-transform: uppercase; font-weight: 600;">Proteksi Kerahasiaan</span>
                    <div style="display: flex; align-items: center; gap: 0.375rem; margin-top: 0.25rem;">
                        @if (_challenge.RequiresManualNdaApproval)
                        {
                            <span class="pv-badge pv-badge-warning" style="font-size: 0.75rem;">NDA + Verifikasi Manual</span>
                        }
                        else
                        {
                            <span class="pv-badge pv-badge-secondary" style="font-size: 0.75rem;">NDA Instan Digital</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Statement & Description -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2rem;">
            <div style="display: flex; flex-direction: column; gap: 2rem;">
                <!-- Section: Problem Statement -->
                <div class="pv-card" style="padding: 1.75rem;">
                    <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--pv-color-text); margin: 0 0 1rem 0; display: flex; align-items: center; gap: 0.5rem;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pv-color-primary);">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        Rumusan Permasalahan Industri (Problem Statement)
                    </h3>
                    <div style="color: var(--pv-color-text); line-height: 1.7; white-space: pre-wrap; font-size: 0.9375rem;">
                        @_challenge.ProblemStatement
                    </div>
                </div>

                <!-- Section: Scope -->
                @if (!string.IsNullOrWhiteSpace(_challenge.ResearchScope))
                {
                    <div class="pv-card" style="padding: 1.75rem;">
                        <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--pv-color-text); margin: 0 0 1rem 0;">
                            Ruang Lingkup Penelitian (Research Scope)
                        </h3>
                        <div style="color: var(--pv-color-text); line-height: 1.7; white-space: pre-wrap; font-size: 0.9375rem;">
                            @_challenge.ResearchScope
                        </div>
                    </div>
                }

                <!-- Section: Outcomes -->
                <div class="pv-card" style="padding: 1.75rem;">
                    <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--pv-color-text); margin: 0 0 1rem 0;">
                        Target Luaran & Hasil Riset yang Diharapkan
                    </h3>
                    <div style="color: var(--pv-color-text); line-height: 1.6; white-space: pre-wrap; font-size: 0.9375rem;">
                        @_challenge.ExpectedOutcomes
                    </div>
                </div>

                <!-- Section: Two-Tier Attachment Repository & NDA Gating -->
                <div class="pv-card" style="padding: 1.75rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                        <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--pv-color-text); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pv-color-secondary);">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            Repositori Lampiran & Spesifikasi Teknis
                        </h3>

                        @if (_ndaStatus != null && _ndaStatus.HasSignedNda && _ndaStatus.IsApproved)
                        {
                            <span class="pv-badge pv-badge-success" style="display: inline-flex; align-items: center; gap: 0.25rem;">
                                ✓ Akses NDA Terverifikasi
                            </span>
                        }
                    </div>

                    <!-- Public Attachments -->
                    <div style="margin-bottom: 1.5rem;">
                        <h4 style="font-size: 0.8125rem; text-transform: uppercase; color: var(--pv-color-text-muted); margin: 0 0 0.75rem 0; font-weight: 600;">
                            Lampiran Publik (Terbuka untuk Umum)
                        </h4>

                        @{
                            var publicFiles = _challenge.Attachments.Where(a => a.ConfidentialityLevel == AttachmentConfidentialityLevel.PublicBriefing).ToList();
                        }

                        @if (publicFiles.Count == 0)
                        {
                            <p style="font-size: 0.875rem; color: var(--pv-color-text-muted); margin: 0;">Tidak ada lampiran publik khusus.</p>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                @foreach (var att in publicFiles)
                                {
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; background: var(--pv-color-surface); border: 1px solid var(--pv-color-border); border-radius: 6px;">
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pv-color-text-muted);">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                            </svg>
                                            <span style="font-size: 0.875rem; font-weight: 600; color: var(--pv-color-text);">@att.FileName</span>
                                            <span style="font-size: 0.75rem; color: var(--pv-color-text-muted);">(@FormatFileSize(att.SizeBytes))</span>
                                        </div>
                                        <button class="pv-btn pv-btn-sm pv-btn-ghost" @onclick="() => DownloadAttachment(att)">
                                            Unduh Dokumen
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Confidential Attachments (Gated by NDA) -->
                    <div>
                        <h4 style="font-size: 0.8125rem; text-transform: uppercase; color: var(--pv-color-text-muted); margin: 0 0 0.75rem 0; font-weight: 600;">
                            Lampiran Rahasia & Spesifikasi Proprietary (NDA Gated)
                        </h4>

                        @{
                            var confidentialFiles = _challenge.Attachments.Where(a => a.ConfidentialityLevel == AttachmentConfidentialityLevel.ConfidentialNdaRequired).ToList();
                        }

                        @if (confidentialFiles.Count == 0)
                        {
                            <p style="font-size: 0.875rem; color: var(--pv-color-text-muted); margin: 0;">Tidak ada dokumen rahasia tambahan untuk tantangan ini.</p>
                        }
                        else if (_ndaStatus != null && _ndaStatus.HasSignedNda && _ndaStatus.IsApproved)
                        {
                            <!-- Unlocked view -->
                            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                @foreach (var att in confidentialFiles)
                                {
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; background: rgba(24, 124, 120, 0.05); border: 1px solid var(--pv-color-secondary); border-radius: 6px;">
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pv-color-secondary);">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                            </svg>
                                            <span style="font-size: 0.875rem; font-weight: 600; color: var(--pv-color-text);">@att.FileName</span>
                                            <span class="pv-badge pv-badge-secondary" style="font-size: 0.6875rem;">NDA Rahasia</span>
                                            <span style="font-size: 0.75rem; color: var(--pv-color-text-muted);">(@FormatFileSize(att.SizeBytes))</span>
                                        </div>
                                        <button class="pv-btn pv-btn-sm pv-btn-primary" @onclick="() => DownloadAttachment(att)">
                                            Unduh Dokumen Rahasia
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Locked view -->
                            <div style="background: rgba(234, 88, 12, 0.05); border: 1px dashed var(--pv-color-warning); border-radius: 8px; padding: 1.5rem; text-align: center;">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--pv-color-warning)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.75rem;">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <h4 style="font-size: 1rem; font-weight: 600; color: var(--pv-color-text); margin: 0 0 0.5rem 0;">
                                    Terdapat @confidentialFiles.Count Lampiran Teknis yang Dilindungi NDA
                                </h4>
                                <p style="font-size: 0.875rem; color: var(--pv-color-text-muted); margin: 0 auto 1.25rem auto; max-width: 500px;">
                                    Untuk mengunduh dataset, skema proprietary, dan parameter teknis terperinci, Anda harus menandatangani Perjanjian Kerahasiaan (Non-Disclosure Agreement) secara digital.
                                </p>
                                <button class="pv-btn pv-btn-primary" @onclick="OpenNdaModal">
                                    Tinjau & Tandatangani NDA Digital
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Sidebar Info: Competencies & Sponsors -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <!-- Domains & Skills -->
                <div class="pv-card" style="padding: 1.5rem;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--pv-color-text); margin: 0 0 1rem 0;">
                        Kualifikasi & Kepakaran
                    </h3>

                    <div style="margin-bottom: 1.25rem;">
                        <span style="display: block; font-size: 0.75rem; color: var(--pv-color-text-muted); margin-bottom: 0.5rem; text-transform: uppercase;">
                            Domain Riset Utama
                        </span>
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            @foreach (var d in _challenge.Domains)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8125rem;">
                                    <span style="font-weight: 600; color: var(--pv-color-text);">@d.DomainName</span>
                                    @if (!string.IsNullOrEmpty(d.SubDomain))
                                    {
                                        <span style="color: var(--pv-color-text-muted);">@d.SubDomain</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div>
                        <span style="display: block; font-size: 0.75rem; color: var(--pv-color-text-muted); margin-bottom: 0.5rem; text-transform: uppercase;">
                            Kompetensi yang Dibutuhkan
                        </span>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            @foreach (var req in _challenge.RequiredExpertise)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8125rem; background: var(--pv-color-surface); padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid var(--pv-color-border);">
                                    <span style="font-weight: 500; color: var(--pv-color-text);">@req.SkillOrDiscipline</span>
                                    @if (req.ImportanceLevel == RequirementImportance.Required)
                                    {
                                        <span class="pv-badge pv-badge-warning" style="font-size: 0.6875rem;">Wajib</span>
                                    }
                                    else
                                    {
                                        <span class="pv-badge pv-badge-ghost" style="font-size: 0.6875rem;">Disukai</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Call to Action Proposal submission -->
                <div class="pv-card" style="padding: 1.5rem; background: linear-gradient(135deg, rgba(23, 54, 93, 0.05) 0%, rgba(24, 124, 120, 0.08) 100%); border: 1px solid var(--pv-color-border);">
                    <h4 style="font-size: 1rem; font-weight: 700; color: var(--pv-color-text); margin: 0 0 0.5rem 0;">
                        Siap Mengajukan Solusi Riset?
                    </h4>
                    <p style="font-size: 0.8125rem; color: var(--pv-color-text-muted); line-height: 1.5; margin: 0 0 1rem 0;">
                        Susun proposal penelitian terstruktur bersama tim atau laboratorium Anda untuk menjawab tantangan industri ini.
                    </p>
                    <button class="pv-btn pv-btn-primary" style="width: 100%; justify-content: center;" @onclick="HandleSubmitProposalClick">
                        Ajukan Proposal Riset (Milestone P)
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Digital NDA Modal -->
@if (_showNdaModal && _challenge != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
        <div class="pv-card" style="max-width: 650px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; padding: 0; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);">
            <!-- Modal Header -->
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--pv-color-border); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--pv-color-text); margin: 0;">
                    Perjanjian Kerahasiaan Riset (Digital NDA)
                </h3>
                <button class="pv-btn pv-btn-ghost pv-btn-sm" @onclick="CloseNdaModal" style="padding: 0.25rem 0.5rem;">✕</button>
            </div>

            <!-- Modal Body -->
            <div style="padding: 1.5rem; overflow-y: auto; flex: 1;">
                <div style="background: rgba(23, 54, 93, 0.05); padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.8125rem;">
                    <strong>Pemberi Informasi:</strong> @_challenge.OrganizationName <br />
                    <strong>Tantangan:</strong> @_challenge.Title <br />
                    <strong>Versi NDA:</strong> @_challenge.NdaTermsVersion
                </div>

                <div style="border: 1px solid var(--pv-color-border); border-radius: 6px; padding: 1rem; font-size: 0.8125rem; line-height: 1.6; max-height: 200px; overflow-y: auto; background: var(--pv-color-surface); margin-bottom: 1.25rem; font-family: monospace;">
                    @(_challenge.NdaTermsText ?? "Ketentuan Baku Perjanjian Kerahasiaan (Non-Disclosure Agreement) Pavena Research Collaboration. Penerima informasi sepakat untuk menjaga seluruh data teknis, algoritma, spesifikasi arsitektur, dan materi rahasia lainnya yang diserahkan dalam kerangka tantangan ini tanpa menyebarluaskannya kepada pihak ketiga.")
                </div>

                <!-- Acceptance Checkbox -->
                <div style="margin-bottom: 1rem;">
                    <label style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.8125rem; color: var(--pv-color-text); cursor: pointer;">
                        <input type="checkbox" @bind="_hasAcceptedTerms" style="margin-top: 0.25rem;" />
                        <span>Saya telah membaca, memahami, dan menyetujui seluruh klausul Perjanjian Kerahasiaan (NDA) di atas atas nama diri saya dan tim riset saya.</span>
                    </label>
                </div>

                <!-- Signature input -->
                <div style="margin-bottom: 0.5rem;">
                    <label style="display: block; font-size: 0.8125rem; font-weight: 600; color: var(--pv-color-text); margin-bottom: 0.375rem;">
                        Tanda Tangan Digital (Ketik Nama Lengkap Resmi)
                    </label>
                    <input type="text" class="pv-input" placeholder="Nama Lengkap Peneliti" @bind="_signatoryName" style="width: 100%;" />
                </div>
            </div>

            <!-- Modal Footer -->
            <div style="padding: 1rem 1.5rem; border-top: 1px solid var(--pv-color-border); display: flex; justify-content: flex-end; gap: 0.75rem; background: var(--pv-color-surface);">
                <button class="pv-btn pv-btn-ghost" @onclick="CloseNdaModal" disabled="@_isSigning">
                    Batal
                </button>
                <button class="pv-btn pv-btn-primary" @onclick="SubmitNdaSignature" disabled="@(!_hasAcceptedTerms || string.IsNullOrWhiteSpace(_signatoryName) || _isSigning)">
                    @if (_isSigning)
                    {
                        <span>Memproses Tanda Tangan...</span>
                    }
                    else
                    {
                        <span>Tandatangani & Buka Akses</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private ChallengeDetailDto? _challenge;
    private EligibilityCheckResultDto? _eligibilityResult;
    private ChallengeNdaStatusDto? _ndaStatus;

    // NDA Modal state
    private bool _showNdaModal = false;
    private bool _hasAcceptedTerms = false;
    private string _signatoryName = string.Empty;
    private bool _isSigning = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadChallengeDataAsync();
    }

    private async Task LoadChallengeDataAsync()
    {
        _isLoading = true;
        try
        {
            _challenge = await ChallengeClient.GetChallengeByIdAsync(Id);
            if (_challenge != null)
            {
                _eligibilityResult = await ChallengeClient.CheckEligibilityAsync(Id);
                _ndaStatus = await ChallengeClient.GetNdaStatusAsync(Id);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal memuat detail tantangan: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenNdaModal()
    {
        _hasAcceptedTerms = false;
        _signatoryName = string.Empty;
        _showNdaModal = true;
    }

    private void CloseNdaModal()
    {
        _showNdaModal = false;
    }

    private async Task SubmitNdaSignature()
    {
        if (!_hasAcceptedTerms || string.IsNullOrWhiteSpace(_signatoryName) || _challenge == null)
        {
            return;
        }

        _isSigning = true;
        try
        {
            var terms = _challenge.NdaTermsText ?? "default_terms";
            var hash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(terms)));

            var req = new SignNdaRequest(
                NdaVersion: _challenge.NdaTermsVersion ?? "1.0",
                TermsContentHash: hash
            );

            var res = await ChallengeClient.SignNdaAsync(Id, req);
            if (res != null)
            {
                _ndaStatus = res;
                _showNdaModal = false;
                ToastService.ShowSuccess("NDA berhasil ditandatangani. Akses lampiran rahasia telah dibuka!");
                await LoadChallengeDataAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal menandatangani NDA: " + ex.Message);
        }
        finally
        {
            _isSigning = false;
        }
    }

    private async Task DownloadAttachment(ChallengeAttachmentDto attachment)
    {
        try
        {
            var bytes = await ChallengeClient.DownloadAttachmentBytesAsync(Id, attachment.Id);
            if (bytes != null)
            {
                ToastService.ShowSuccess($"Mengunduh berkas {attachment.FileName} ({FormatFileSize(attachment.SizeBytes)})");
            }
            else
            {
                ToastService.ShowInfo($"Memulai unduhan untuk {attachment.FileName}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Gagal mengunduh lampiran: " + ex.Message);
        }
    }

    private void HandleSubmitProposalClick()
    {
        ToastService.ShowInfo("Alur pengajuan proposal riset untuk tantangan industri dijadwalkan pada Milestone P.");
    }

    private string FormatBudget(string? currency, decimal? min, decimal? max)
    {
        var cur = currency ?? "USD";
        if (!min.HasValue && !max.HasValue) return "Dinegosiasikan";
        if (min.HasValue && max.HasValue) return $"{cur} {min.Value:N0} – {max.Value:N0}";
        if (min.HasValue) return $"Mulai {cur} {min.Value:N0}";
        return max.HasValue ? $"Hingga {cur} {max.Value:N0}" : "Dinegosiasikan";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}
