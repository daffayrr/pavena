@namespace Pavena.Web.Components.Network
@using Pavena.Web.Components.UI

<nav class="pv-network-nav" aria-label="Navigasi Jaringan & Kolega">
    <a href="/network/discover" class="pv-network-nav-item @(ActiveTab == "discover" ? "is-active" : "")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
        <span>Eksplorasi Rekan</span>
    </a>

    <a href="/network/connections" class="pv-network-nav-item @(ActiveTab == "connections" ? "is-active" : "")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>Koneksi Saya</span>
        @if (ConnectionsCount > 0)
        {
            <PvBadge Variant="@(ActiveTab == "connections" ? "primary" : "neutral")">@ConnectionsCount</PvBadge>
        }
    </a>

    <a href="/network/requests" class="pv-network-nav-item @(ActiveTab == "requests" ? "is-active" : "")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
        </svg>
        <span>Permintaan</span>
        @if (PendingRequestsCount > 0)
        {
            <PvBadge Variant="danger">@PendingRequestsCount</PvBadge>
        }
    </a>

    <a href="/network/following" class="pv-network-nav-item @(ActiveTab == "following" ? "is-active" : "")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Mengikuti</span>
        @if (FollowingCount > 0)
        {
            <PvBadge Variant="@(ActiveTab == "following" ? "secondary" : "neutral")">@FollowingCount</PvBadge>
        }
    </a>

    <a href="/network/followers" class="pv-network-nav-item @(ActiveTab == "followers" ? "is-active" : "")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
        </svg>
        <span>Pengikut</span>
        @if (FollowersCount > 0)
        {
            <PvBadge Variant="@(ActiveTab == "followers" ? "secondary" : "neutral")">@FollowersCount</PvBadge>
        }
    </a>

    <a href="/network/blocked" class="pv-network-nav-item @(ActiveTab == "blocked" ? "is-active" : "")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        <span>Pengguna Diblokir</span>
    </a>
</nav>

@code {
    [Parameter] public string ActiveTab { get; set; } = "discover";
    [Parameter] public int ConnectionsCount { get; set; }
    [Parameter] public int PendingRequestsCount { get; set; }
    [Parameter] public int FollowingCount { get; set; }
    [Parameter] public int FollowersCount { get; set; }
}
