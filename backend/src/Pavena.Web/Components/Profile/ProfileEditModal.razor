@namespace Pavena.Web.Components.Profile
@using Pavena.Application.Identity.DTOs
@using Pavena.Web.Components.UI
@using Pavena.Web.Services.Profile
@using Pavena.Web.Services.Toast
@inject IAcademicProfileClient ProfileClient
@inject IToastService ToastService

<PvModal IsOpen="@IsOpen" IsOpenChanged="@IsOpenChanged" Title="Pengaturan & Edit Profil Akademik" MaxWidth="720px">
    <ChildContent>
        <div style="margin-bottom: var(--pv-space-4);">
            <PvTabs Tabs="@editTabs" ActiveTab="@activeTab" ActiveTabChanged="HandleTabChanged" />
        </div>

        @if (activeTab == "basic")
        {
            <div style="display: flex; flex-direction: column; gap: var(--pv-space-4);">
                <PvInput Id="edit-display-name"
                         Label="Nama Lengkap & Gelar"
                         Required="true"
                         Value="@editDisplayName"
                         ValueChanged="@(val => editDisplayName = val)"
                         Placeholder="Contoh: Dr. Marie Curie" />

                <PvInput Id="edit-headline"
                         Label="Headline Akademik"
                         Value="@editHeadline"
                         ValueChanged="@(val => editHeadline = val)"
                         Placeholder="Contoh: Professor of Chemistry | Nuclear Physics Researcher"
                         HintMessage="Ringkasan posisi atau fokus penelitian Anda." />

                <PvInput Id="edit-bio"
                         Label="Biografi Ilmiah"
                         IsMultiline="true"
                         Rows="4"
                         Value="@editBio"
                         ValueChanged="@(val => editBio = val)"
                         Placeholder="Tuliskan latar belakang penelitian, minat akademik, dan visi riset Anda..." />

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--pv-space-4);">
                    <PvInput Id="edit-city"
                             Label="Kota"
                             Value="@editCity"
                             ValueChanged="@(val => editCity = val)"
                             Placeholder="Contoh: Paris" />

                    <PvInput Id="edit-country"
                             Label="Kode Negara"
                             Value="@editCountryCode"
                             ValueChanged="@(val => editCountryCode = val)"
                             Placeholder="Contoh: FR" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--pv-space-4);">
                    <div class="pv-form-group">
                        <label class="pv-label" for="edit-lang">Bahasa Pilihan</label>
                        <select id="edit-lang" class="pv-input" @bind="editPreferredLanguage">
                            <option value="en">English (en)</option>
                            <option value="id">Bahasa Indonesia (id)</option>
                            <option value="fr">Français (fr)</option>
                            <option value="de">Deutsch (de)</option>
                        </select>
                    </div>

                    <div class="pv-form-group">
                        <label class="pv-label" for="edit-privacy">Tingkat Visibilitas Profil</label>
                        <select id="edit-privacy" class="pv-input" @bind="editVisibility">
                            <option value="Public">Publik (Semua peneliti & mesin pencari)</option>
                            <option value="NetworkOnly">Jaringan Kolega (Hanya koneksi terdaftar)</option>
                            <option value="Private">Privat (Hanya diri sendiri)</option>
                        </select>
                    </div>
                </div>
            </div>
        }
        else if (activeTab == "education")
        {
            <div style="display: flex; flex-direction: column; gap: var(--pv-space-3);">
                <PvInput Id="edu-inst"
                         Label="Nama Institusi / Universitas"
                         Required="true"
                         Value="@newEduInstitution"
                         ValueChanged="@(v => newEduInstitution = v)"
                         Placeholder="Contoh: Sorbonne Université" />

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--pv-space-3);">
                    <PvInput Id="edu-degree"
                             Label="Gelar"
                             Required="true"
                             Value="@newEduDegree"
                             ValueChanged="@(v => newEduDegree = v)"
                             Placeholder="Contoh: Ph.D. / Doktor" />

                    <PvInput Id="edu-field"
                             Label="Bidang Studi"
                             Value="@newEduField"
                             ValueChanged="@(v => newEduField = v)"
                             Placeholder="Contoh: Fisika Material" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--pv-space-3);">
                    <div class="pv-form-group">
                        <label class="pv-label" for="edu-start">Tahun Mulai</label>
                        <input id="edu-start" type="number" class="pv-input" @bind="newEduStartYear" min="1900" max="2100" />
                    </div>
                    <div class="pv-form-group">
                        <label class="pv-label" for="edu-end">Tahun Selesai (Kosongkan bila aktif)</label>
                        <input id="edu-end" type="number" class="pv-input" @bind="newEduEndYear" min="1900" max="2100" />
                    </div>
                </div>

                <PvInput Id="edu-grade"
                         Label="Predikat Kelulusan / Penghargaan"
                         Value="@newEduGrade"
                         ValueChanged="@(v => newEduGrade = v)"
                         Placeholder="Contoh: Summa Cum Laude" />

                <div style="margin-top: 8px;">
                    <PvButton Variant="primary" Size="sm" IsLoading="@isSavingSubItem" OnClick="SaveEducation">
                        <span>Simpan Riwayat Pendidikan</span>
                    </PvButton>
                </div>
            </div>
        }
        else if (activeTab == "experience")
        {
            <div style="display: flex; flex-direction: column; gap: var(--pv-space-3);">
                <PvInput Id="exp-org"
                         Label="Lembaga / Universitas / Lab"
                         Required="true"
                         Value="@newExpOrg"
                         ValueChanged="@(v => newExpOrg = v)"
                         Placeholder="Contoh: Institut du Radium" />

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--pv-space-3);">
                    <PvInput Id="exp-role"
                             Label="Jabatan / Peran Riset"
                             Required="true"
                             Value="@newExpRole"
                             ValueChanged="@(v => newExpRole = v)"
                             Placeholder="Contoh: Principal Investigator" />

                    <PvInput Id="exp-type"
                             Label="Jenis Posisi"
                             Value="@newExpType"
                             ValueChanged="@(v => newExpType = v)"
                             Placeholder="Contoh: Full-time / Fellow" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--pv-space-3);">
                    <div class="pv-form-group">
                        <label class="pv-label" for="exp-start">Tanggal Mulai</label>
                        <input id="exp-start" type="date" class="pv-input" @bind="newExpStartDate" />
                    </div>
                    <div class="pv-form-group">
                        <label class="pv-label" for="exp-end">Tanggal Berakhir</label>
                        <input id="exp-end" type="date" class="pv-input" @bind="newExpEndDate" disabled="@newExpIsCurrent" />
                    </div>
                </div>

                <div class="pv-form-group">
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 0.875rem; cursor: pointer;">
                        <input type="checkbox" @bind="newExpIsCurrent" />
                        <span>Saya sedang menduduki posisi riset ini</span>
                    </label>
                </div>

                <PvInput Id="exp-desc"
                         Label="Deskripsi Tanggung Jawab & Hibah Riset"
                         IsMultiline="true"
                         Rows="3"
                         Value="@newExpDesc"
                         ValueChanged="@(v => newExpDesc = v)"
                         Placeholder="Fokus pengujian, pengelolaan laboratorium, hibah riset, atau pencapaian..." />

                <div style="margin-top: 8px;">
                    <PvButton Variant="primary" Size="sm" IsLoading="@isSavingSubItem" OnClick="SaveExperience">
                        <span>Simpan Pengalaman Riset</span>
                    </PvButton>
                </div>
            </div>
        }
        else if (activeTab == "preview")
        {
            <div style="padding: var(--pv-space-4); background-color: var(--pv-color-background); border-radius: var(--pv-radius-md); border: 1px solid var(--pv-color-border);">
                <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--pv-color-secondary); margin-bottom: 8px;">
                    Pratinjau Tampilan Profil Kolega
                </div>
                <div style="font-size: 1.25rem; font-weight: 700; color: var(--pv-color-text);">
                    @(string.IsNullOrWhiteSpace(editDisplayName) ? Profile.DisplayName : editDisplayName)
                </div>
                <div style="font-size: 0.9375rem; color: var(--pv-color-text-muted); margin-top: 2px;">
                    @(string.IsNullOrWhiteSpace(editHeadline) ? "Belum ada headline akademik" : editHeadline)
                </div>
                <div style="font-size: 0.875rem; margin-top: 12px; line-height: 1.5; color: var(--pv-color-text);">
                    @(string.IsNullOrWhiteSpace(editBio) ? "Belum ada biografi ilmiah." : editBio)
                </div>
                <div style="margin-top: 12px; display: flex; gap: 12px; font-size: 0.8125rem; color: var(--pv-color-text-muted);">
                    @if (!string.IsNullOrWhiteSpace(editCity) || !string.IsNullOrWhiteSpace(editCountryCode))
                    {
                        <span>📍 @editCity, @editCountryCode</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Profile.Orcid))
                    {
                        <span class="pv-orcid-badge" style="font-size: 0.6875rem; padding: 2px 6px;">iD @Profile.Orcid</span>
                    }
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <PvButton Variant="ghost" OnClick="HandleClose">Batal</PvButton>
        <PvButton Variant="primary" IsLoading="@isSaving" OnClick="HandleSaveBasicProfile">
            <span>Simpan Perubahan</span>
        </PvButton>
    </Footer>
</PvModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public AcademicProfileDto Profile { get; set; } = default!;
    [Parameter] public EventCallback OnProfileSaved { get; set; }

    private string activeTab = "basic";
    private bool isSaving = false;
    private bool isSavingSubItem = false;

    // Basic form fields
    private string editDisplayName = "";
    private string editHeadline = "";
    private string editBio = "";
    private string editCity = "";
    private string editCountryCode = "";
    private string editPreferredLanguage = "en";
    private string editVisibility = "Public";

    // New Education fields
    private string newEduInstitution = "";
    private string newEduDegree = "";
    private string newEduField = "";
    private int? newEduStartYear;
    private int? newEduEndYear;
    private string newEduGrade = "";

    // New Experience fields
    private string newExpOrg = "";
    private string newExpRole = "";
    private string newExpType = "Full-time";
    private DateTime newExpStartDate = DateTime.UtcNow.AddYears(-2);
    private DateTime? newExpEndDate;
    private bool newExpIsCurrent = true;
    private string newExpDesc = "";

    private readonly List<PvTabs.TabItem> editTabs = new()
    {
        new("basic", "Informasi Dasar"),
        new("education", "Tambah Pendidikan"),
        new("experience", "Tambah Pengalaman"),
        new("preview", "Pratinjau")
    };

    protected override void OnParametersSet()
    {
        if (Profile != null)
        {
            editDisplayName = Profile.DisplayName;
            editHeadline = Profile.Headline ?? "";
            editBio = Profile.Bio ?? "";
            editCity = Profile.City ?? "";
            editCountryCode = Profile.CountryCode ?? "";
            editPreferredLanguage = Profile.PreferredLanguage ?? "en";
            editVisibility = Profile.Visibility ?? "Public";
        }
    }

    private void HandleTabChanged(string tab)
    {
        activeTab = tab;
    }

    private async Task HandleClose()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSaveBasicProfile()
    {
        if (string.IsNullOrWhiteSpace(editDisplayName))
        {
            ToastService.ShowError("Nama tampilan tidak boleh kosong.");
            return;
        }

        isSaving = true;
        try
        {
            var req = new UpdateProfileRequest(
                editDisplayName,
                editHeadline,
                editBio,
                editCountryCode,
                editCity,
                editPreferredLanguage,
                editVisibility
            );

            var updated = await ProfileClient.UpdateProfileAsync(req);
            if (updated != null)
            {
                ToastService.ShowSuccess("Profil akademik berhasil diperbarui.");
                await OnProfileSaved.InvokeAsync();
                await HandleClose();
            }
            else
            {
                ToastService.ShowError("Gagal memperbarui profil. Silakan periksa kembali data Anda.");
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveEducation()
    {
        if (string.IsNullOrWhiteSpace(newEduInstitution) || string.IsNullOrWhiteSpace(newEduDegree))
        {
            ToastService.ShowError("Nama institusi dan gelar wajib diisi.");
            return;
        }

        isSavingSubItem = true;
        try
        {
            var req = new CreateEducationRequest(
                newEduInstitution,
                newEduDegree,
                newEduField,
                newEduStartYear,
                newEduEndYear,
                newEduGrade
            );

            var result = await ProfileClient.AddEducationAsync(req);
            if (result != null)
            {
                ToastService.ShowSuccess($"Riwayat pendidikan di {newEduInstitution} berhasil ditambahkan.");
                newEduInstitution = "";
                newEduDegree = "";
                newEduField = "";
                newEduStartYear = null;
                newEduEndYear = null;
                newEduGrade = "";
                await OnProfileSaved.InvokeAsync();
            }
            else
            {
                ToastService.ShowError("Gagal menambahkan riwayat pendidikan.");
            }
        }
        finally
        {
            isSavingSubItem = false;
        }
    }

    private async Task SaveExperience()
    {
        if (string.IsNullOrWhiteSpace(newExpOrg) || string.IsNullOrWhiteSpace(newExpRole))
        {
            ToastService.ShowError("Lembaga dan peran wajib diisi.");
            return;
        }

        isSavingSubItem = true;
        try
        {
            var req = new CreateExperienceRequest(
                newExpOrg,
                newExpRole,
                newExpType,
                newExpStartDate,
                newExpIsCurrent ? null : newExpEndDate,
                newExpIsCurrent,
                newExpDesc
            );

            var result = await ProfileClient.AddExperienceAsync(req);
            if (result != null)
            {
                ToastService.ShowSuccess($"Pengalaman riset di {newExpOrg} berhasil ditambahkan.");
                newExpOrg = "";
                newExpRole = "";
                newExpType = "Full-time";
                newExpStartDate = DateTime.UtcNow.AddYears(-1);
                newExpEndDate = null;
                newExpIsCurrent = true;
                newExpDesc = "";
                await OnProfileSaved.InvokeAsync();
            }
            else
            {
                ToastService.ShowError("Gagal menambahkan pengalaman riset.");
            }
        }
        finally
        {
            isSavingSubItem = false;
        }
    }
}
