@inject NavigationManager Navigation

<header class="pv-topbar">
    <div class="pv-topbar-left">
        <button type="button" class="pv-mobile-menu-btn" @onclick="OnToggleMobileNav" aria-label="Buka Navigasi">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <PvBrandLogo ShowTagline="true" />
    </div>

    <div class="pv-topbar-center">
        <PvSearch Placeholder="Cari artikel ilmiah, peneliti, publikasi..." OnSearch="HandleSearch" />
    </div>

    <div class="pv-topbar-right">
        <!-- Notification button with indicator -->
        <PvButton Variant="ghost" Size="sm" IconOnly="true" AriaLabel="Pemberitahuan">
            <div style="position: relative; display: flex; align-items: center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span style="position: absolute; top: -3px; right: -3px; width: 8px; height: 8px; border-radius: 50%; background-color: var(--pv-color-danger); border: 1px solid var(--pv-color-surface);"></span>
            </div>
        </PvButton>

        <!-- Theme Toggle -->
        <PvThemeToggle />

        <!-- User Account Menu -->
        <PvDropdown Align="right">
            <Trigger>
                <button type="button" class="pv-btn pv-btn-ghost" style="padding: 2px 6px; border-radius: var(--pv-radius-full); display: flex; align-items: center; gap: 8px;" aria-label="Menu Akun">
                    <PvAvatar Name="Dr. Marie Curie" Size="sm" Status="online" />
                    <span style="font-size: 0.875rem; font-weight: 500; display: inline-block; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Dr. Marie Curie</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pv-color-text-muted);">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            </Trigger>
            <ChildContent>
                <div style="padding: 0.75rem 0.85rem; border-bottom: 1px solid var(--pv-color-border);">
                    <div style="font-weight: 600; font-size: 0.875rem; color: var(--pv-color-text);">Dr. Marie Curie</div>
                    <div style="font-size: 0.75rem; color: var(--pv-color-text-muted);">marie.curie@sorbonne.ac.fr</div>
                    <div style="margin-top: 4px;">
                        <PvBadge Variant="primary">Peneliti Utama</PvBadge>
                    </div>
                </div>

                <a href="/profile" class="pv-dropdown-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Profil Akademik</span>
                </a>

                <a href="/posts/mine" class="pv-dropdown-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    <span>Publikasi & Draf</span>
                </a>

                <a href="/posts/create" class="pv-dropdown-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Tulis Post Baru</span>
                </a>

                <a href="/design-system" class="pv-dropdown-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    <span>Design System Hub</span>
                </a>

                <div class="pv-dropdown-divider"></div>

                <button type="button" class="pv-dropdown-item is-danger" @onclick="HandleLogout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Keluar Akun</span>
                </button>
            </ChildContent>
        </PvDropdown>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggleMobileNav { get; set; }

    private void HandleSearch(string query)
    {
        if (!string.IsNullOrWhiteSpace(query))
        {
            Navigation.NavigateTo($"/discover?q={Uri.EscapeDataString(query)}");
        }
    }

    private void HandleLogout()
    {
        Navigation.NavigateTo("/login");
    }
}
