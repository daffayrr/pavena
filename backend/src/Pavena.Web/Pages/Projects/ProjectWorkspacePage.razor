            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.375rem;">Target Tanggal Selesai</label>
                <input type="date" class="pv-input" style="width: 100%;" @bind="_newMilestoneDate" />
            </div>
            <div style="margin-bottom: 1.25rem;">
                <label style="display: block; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.375rem;">Deskripsi Target</label>
                <textarea class="pv-input" rows="2" style="width: 100%;" placeholder="Detail luaran yang diharapkan..." @bind="_newMilestoneDesc"></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button class="pv-btn pv-btn-ghost" @onclick="() => _showMilestoneModal = false">Batal</button>
