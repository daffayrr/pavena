                </svg>
            </span>
            <span>Design System Hub</span>
            <PvBadge Variant="secondary" Class="pv-nav-badge">v1.0</PvBadge>
        </NavLink>
    </div>

    <div style="padding: 0.75rem 0.5rem; border-top: 1px solid var(--pv-color-border); font-size: 0.75rem; color: var(--pv-color-text-muted);">
        <div>Pavena Academic Platform</div>
        <div style="font-size: 0.6875rem; color: var(--pv-color-text-subtle); margin-top: 2px;">Integritas & Kebebasan Riset</div>
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnCloseMobileNav { get; set; }

    private async Task HandleLinkClick()
    {
        if (IsOpen)
        {
            await OnCloseMobileNav.InvokeAsync();
        }
    }
}
