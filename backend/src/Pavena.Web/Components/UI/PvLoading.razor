@if (Type == "spinner")
{
    <div class="pv-spinner @Class" style="@GetSpinnerStyle()" role="status" aria-label="Memuat...">
        <span class="sr-only">Memuat...</span>
    </div>
}
else if (Type == "feed-card")
{
    <div class="pv-card" style="padding: 1.25rem; margin-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            <div class="pv-skeleton pv-skeleton-circle"></div>
            <div style="flex: 1;">
                <div class="pv-skeleton pv-skeleton-text short"></div>
                <div class="pv-skeleton pv-skeleton-text" style="width: 25%; margin-bottom: 0;"></div>
            </div>
        </div>
        <div class="pv-skeleton pv-skeleton-text"></div>
        <div class="pv-skeleton pv-skeleton-text"></div>
        <div class="pv-skeleton pv-skeleton-text medium"></div>
    </div>
}
else
{
    <div class="pv-skeleton @(Circle ? "pv-skeleton-circle" : "pv-skeleton-text") @Class"
         style="@Style"
         role="status"
         aria-label="Memuat...">
        <span class="sr-only">Memuat...</span>
    </div>
}

@code {
    [Parameter] public string Type { get; set; } = "skeleton"; // "spinner", "skeleton", "feed-card"
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public bool Circle { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Class { get; set; }

    private string GetSpinnerStyle() => $"width: {Size}px; height: {Size}px; {Style}";
}
