<div class="pv-form-group @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@Id" class="pv-label">
            @Label
            @if (Required)
            {
                <span class="required-indicator" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="pv-input-wrapper">
        @if (PrefixIcon != null)
        {
            <div class="pv-input-icon-prefix">
                @PrefixIcon
            </div>
        }

        @if (IsMultiline)
        {
            <textarea id="@Id"
                      class="pv-textarea @(PrefixIcon != null ? "has-prefix" : "") @(SuffixIcon != null ? "has-suffix" : "") @(!string.IsNullOrEmpty(ErrorMessage) ? "has-error" : "")"
                      placeholder="@Placeholder"
                      disabled="@Disabled"
                      rows="@Rows"
                      value="@Value"
                      @oninput="HandleInput"
                      aria-invalid="@(!string.IsNullOrEmpty(ErrorMessage))"
                      aria-describedby="@GetAriaDescribedBy()"
                      @attributes="AdditionalAttributes"></textarea>
        }
        else
        {
            <input id="@Id"
                   type="@Type"
                   class="pv-input @(PrefixIcon != null ? "has-prefix" : "") @(SuffixIcon != null ? "has-suffix" : "") @(!string.IsNullOrEmpty(ErrorMessage) ? "has-error" : "")"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   value="@Value"
                   @oninput="HandleInput"
                   aria-invalid="@(!string.IsNullOrEmpty(ErrorMessage))"
                   aria-describedby="@GetAriaDescribedBy()"
                   @attributes="AdditionalAttributes" />
        }

        @if (SuffixIcon != null)
        {
            <div class="pv-input-icon-suffix">
                @SuffixIcon
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div id="@($"{Id}-error")" class="pv-error-text" role="alert">
            @ErrorMessage
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div id="@($"{Id}-helper")" class="pv-helper-text">
            @HelperText
        </div>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public RenderFragment? PrefixIcon { get; set; }
    [Parameter] public RenderFragment? SuffixIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsMultiline { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string? GetAriaDescribedBy()
    {
        if (!string.IsNullOrEmpty(ErrorMessage)) return $"{Id}-error";
        if (!string.IsNullOrEmpty(HelperText)) return $"{Id}-helper";
        return null;
    }
}
