@namespace Pavena.Web.Components.Posts

<div class="pv-feed-skeleton-card" aria-hidden="true">
    <div style="display: flex; align-items: center; gap: 12px;">
        <div class="pv-skeleton-avatar"></div>
        <div style="flex: 1; display: flex; flex-direction: column; gap: 6px;">
            <div class="pv-skeleton-line" style="width: 40%;"></div>
            <div class="pv-skeleton-line" style="width: 25%; height: 10px;"></div>
        </div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 8px; margin: 12px 0;">
        <div class="pv-skeleton-line" style="width: 100%;"></div>
        <div class="pv-skeleton-line" style="width: 90%;"></div>
        <div class="pv-skeleton-line" style="width: 70%;"></div>
    </div>
    <div style="display: flex; justify-content: space-between; padding-top: 10px; border-top: 1px solid var(--pv-color-border);">
        <div class="pv-skeleton-line" style="width: 20%; height: 24px;"></div>
        <div class="pv-skeleton-line" style="width: 20%; height: 24px;"></div>
    </div>
</div>
