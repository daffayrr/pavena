@page "/challenges/{ChallengeId:guid}/proposals"
@page "/sponsor/proposals"
@using Pavena.Application.Proposals.DTOs
@using Pavena.Application.Challenges.DTOs
@using Pavena.Domain.Enums
@using Pavena.Web.Services.Proposals
@using Pavena.Web.Services.Challenges
@using Pavena.Web.Services.Auth
@using Pavena.Web.Services.Toast
@inject IProposalClient ProposalClient
@inject IChallengeClient ChallengeClient
@inject NavigationManager Navigation
@inject IToastService Toast
@inject IScholarSessionService Session

<div class="pv-sponsor-inbox-container">
    @if (_isLoading)
    {
        <PvLoading Text="Memuat daftar usulan proposal masuk..." />
    }
    else
    {
        <div class="pv-page-header">
            <div class="pv-breadcrumb">
                <a href="/challenges" class="pv-breadcrumb-link">Tantangan Industri</a>
                <span class="pv-breadcrumb-sep">/</span>
                @if (_challenge != null)
                {
                    <a href="/challenges/@_challenge.Id" class="pv-breadcrumb-link">@_challenge.Title</a>
                    <span class="pv-breadcrumb-sep">/</span>
                }
                <span class="pv-breadcrumb-current">Kotak Masuk Proposal</span>
            </div>
            <div class="pv-header-row">
                <div>
                    <h1 class="pv-page-title">Manajemen Usulan Riset Industri</h1>
                    <p class="pv-page-subtitle">Pusat Seleksi, Review Rubrik, Keputusan Sponsor & Konversi Proyek Hilir</p>
                </div>
            </div>
        </div>

        <!-- Metric Summary Counters -->
        <div class="pv-metrics-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
            <div class="pv-card pv-metric-card">
                <div class="pv-metric-num">@_proposals.Count</div>
                <div class="pv-metric-title">Total Proposal Masuk</div>
            </div>
            <div class="pv-card pv-metric-card">
                <div class="pv-metric-num" style="color: var(--pv-color-primary);">@_proposals.Count(p => p.Status == ProposalStatus.UnderReview || p.Status == ProposalStatus.Submitted)</div>
                <div class="pv-metric-title">Dalam Evaluasi Reviewer</div>
            </div>
            <div class="pv-card pv-metric-card">
                <div class="pv-metric-num" style="color: var(--pv-color-success);">@_proposals.Count(p => p.Status == ProposalStatus.Accepted)</div>
                <div class="pv-metric-title">Proposal Diterima (Awarded)</div>
            </div>
            <div class="pv-card pv-metric-card">
                <div class="pv-metric-num" style="color: #6366f1;">@_proposals.Count(p => p.ConvertedProjectId.HasValue)</div>
                <div class="pv-metric-title">Terkonversi ke Proyek</div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="pv-card" style="margin-bottom: 1.5rem; padding: 1rem;">
            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <span style="font-size: 0.8125rem; font-weight: 600;">Status:</span>
                    <select class="pv-input" @bind="_selectedStatus" @bind:after="FilterProposalsAsync" style="font-size: 0.8125rem; width: auto;">
                        <option value="">Semua Status</option>
                        <option value="@ProposalStatus.Submitted">Diajukan</option>
                        <option value="@ProposalStatus.UnderReview">Dalam Penilaian</option>
                        <option value="@ProposalStatus.RevisionRequested">Perlu Revisi</option>
                        <option value="@ProposalStatus.Accepted">Diterima</option>
                        <option value="@ProposalStatus.ConvertedToProject">Terkonversi</option>
                        <option value="@ProposalStatus.Rejected">Ditolak</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Proposal Cards -->
        @if (!_filteredProposals.Any())
        {
            <PvEmptyState Title="Tidak Ada Usulan Proposal"
                          Description="Belum ada usulan proposal yang sesuai dengan kriteria penyaringan."
                          ActionText="Segarkan"
                          OnActionClick="LoadDataAsync" />
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                @foreach (var p in _filteredProposals)
                {
                    <div class="pv-card pv-proposal-card" style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem;">
                        <div style="flex: 1; margin-right: 1.5rem;">
                            <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem;">
                                <span class="pv-badge pv-badge-version">v@p.SubmissionVersion</span>
                                <span class="pv-badge @GetStatusBadgeClass(p.Status)">@FormatStatus(p.Status)</span>
                                @if (p.AverageScore.HasValue)
                                {
                                    <span class="pv-badge pv-badge-primary">⭐ Rata-rata Skor: @p.AverageScore / 100</span>
                                }
                                <span style="font-size: 0.75rem; color: var(--pv-color-text-muted);">@p.ReviewCount Reviewer Selesai</span>
                            </div>

                            <h3 style="margin: 0 0 0.25rem 0; font-size: 1.125rem; font-weight: 600;">
                                <a href="/proposals/@p.Id" style="color: var(--pv-color-text-primary); text-decoration: none;">@p.Title</a>
                            </h3>

                            <div style="font-size: 0.8125rem; color: var(--pv-color-text-secondary); display: flex; gap: 1rem; flex-wrap: wrap;">
                                <span>👤 <strong>@p.LeadResearcherName</strong></span>
                                @if (!string.IsNullOrEmpty(p.SubmittingOrganizationName))
                                {
                                    <span>🏛️ @p.SubmittingOrganizationName</span>
                                }
                                <span>💰 @p.Currency @p.ProposedBudget.ToString("N0")</span>
                                <span>⏱️ @p.ProposedTimelineMonths Bulan</span>
                                <span>📅 @(p.SubmittedAtUtc?.ToString("dd MMM yyyy") ?? "Draf")</span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            <a href="/proposals/@p.Id" class="pv-btn pv-btn-outline pv-btn-sm">Buka Detail</a>

                            @if (p.Status == ProposalStatus.Accepted && !p.ConvertedProjectId.HasValue)
                            {
                                <button class="pv-btn pv-btn-success pv-btn-sm" @onclick="@(() => ConvertProposalDirectlyAsync(p.Id))">
                                    🚀 Konversi ke Proyek
                                </button>
                            }
                            else if (p.ConvertedProjectId.HasValue)
                            {
                                <a href="/projects/@p.ConvertedProjectId.Value" class="pv-btn pv-btn-outline pv-btn-sm">
                                    📂 Proyek Terkonversi
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid? ChallengeId { get; set; }

    private bool _isLoading = true;
    private ChallengeDetailDto? _challenge;
    private List<ProposalSummaryResponse> _proposals = new();
    private List<ProposalSummaryResponse> _filteredProposals = new();
    private ProposalStatus? _selectedStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            if (ChallengeId.HasValue)
            {
                _challenge = await ChallengeClient.GetChallengeByIdAsync(ChallengeId.Value);
                _proposals = await ProposalClient.GetSummariesAsync(challengeId: ChallengeId.Value);
            }
            else
            {
                _proposals = await ProposalClient.GetSummariesAsync();
            }

            FilterProposalsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Gagal memuat data usulan proposal: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterProposalsAsync()
    {
        if (_selectedStatus.HasValue)
        {
            _filteredProposals = _proposals.Where(p => p.Status == _selectedStatus.Value).ToList();
        }
        else
        {
            _filteredProposals = _proposals.ToList();
        }
    }

    private async Task ConvertProposalDirectlyAsync(Guid proposalId)
    {
        try
        {
            var req = new ConvertProposalRequest();
            var res = await ProposalClient.ConvertToProjectAsync(proposalId, req);
            if (res != null)
            {
                Toast.ShowSuccess($"Berhasil dikonversi ke Proyek Riset '{res.ProjectTitle}'!");
                Navigation.NavigateTo($"/projects/{res.ProjectId}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Konversi gagal: {ex.Message}");
        }
    }

    private static string FormatStatus(ProposalStatus status) => status switch
    {
        ProposalStatus.Draft => "Draf",
        ProposalStatus.Submitted => "Diajukan",
        ProposalStatus.EligibilityReview => "Evaluasi Kelayakan",
        ProposalStatus.UnderReview => "Dalam Penilaian",
        ProposalStatus.RevisionRequested => "Perlu Revisi",
        ProposalStatus.Resubmitted => "Revisi Diajukan",
        ProposalStatus.Accepted => "Diterima / Awarded",
        ProposalStatus.Rejected => "Ditolak",
        ProposalStatus.Withdrawn => "Ditarik",
        ProposalStatus.ConvertedToProject => "Terkonversi",
        _ => status.ToString()
    };

    private static string GetStatusBadgeClass(ProposalStatus status) => status switch
    {
        ProposalStatus.Draft => "pv-badge-draft",
        ProposalStatus.Submitted => "pv-badge-info",
        ProposalStatus.EligibilityReview => "pv-badge-info",
        ProposalStatus.UnderReview => "pv-badge-primary",
        ProposalStatus.RevisionRequested => "pv-badge-warning",
        ProposalStatus.Resubmitted => "pv-badge-info",
        ProposalStatus.Accepted => "pv-badge-success",
        ProposalStatus.Rejected => "pv-badge-danger",
        ProposalStatus.Withdrawn => "pv-badge-secondary",
        ProposalStatus.ConvertedToProject => "pv-badge-success",
        _ => "pv-badge-secondary"
    };
}
