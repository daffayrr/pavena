@inject IThemeService ThemeService
@implements IDisposable

<PvDropdown Align="right" Class="@Class">
    <Trigger>
        <PvButton Variant="ghost" Size="sm" IconOnly="true" AriaLabel="Pengaturan Tema">
            @if (ThemeService.EffectiveTheme == "dark")
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
            }
        </PvButton>
    </Trigger>
    <ChildContent>
        <button type="button"
                class="pv-dropdown-item @(ThemeService.CurrentTheme == ThemeMode.Light ? "is-selected" : "")"
                @onclick="() => SetTheme(ThemeMode.Light)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
            </svg>
            <span>Tema Terang (Light)</span>
            @if (ThemeService.CurrentTheme == ThemeMode.Light)
            {
                <span style="margin-left: auto; color: var(--pv-color-primary);">✓</span>
            }
        </button>

        <button type="button"
                class="pv-dropdown-item @(ThemeService.CurrentTheme == ThemeMode.Dark ? "is-selected" : "")"
                @onclick="() => SetTheme(ThemeMode.Dark)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span>Tema Gelap (Dark)</span>
            @if (ThemeService.CurrentTheme == ThemeMode.Dark)
            {
                <span style="margin-left: auto; color: var(--pv-color-primary);">✓</span>
            }
        </button>

        <div class="pv-dropdown-divider"></div>

        <button type="button"
                class="pv-dropdown-item @(ThemeService.CurrentTheme == ThemeMode.System ? "is-selected" : "")"
                @onclick="() => SetTheme(ThemeMode.System)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span>Ikuti Sistem</span>
            @if (ThemeService.CurrentTheme == ThemeMode.System)
            {
                <span style="margin-left: auto; color: var(--pv-color-primary);">✓</span>
            }
        </button>
    </ChildContent>
</PvDropdown>

@code {
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    private async Task SetTheme(ThemeMode mode)
    {
        await ThemeService.SetThemeAsync(mode);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}
