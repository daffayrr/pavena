        <div class="pv-modal-dialog" @onclick:stopPropagation>
            <h3 style="margin-top: 0; font-size: 1.25rem;">Buat Tugas Riset Baru</h3>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.375rem;">Judul Tugas</label>
                <input type="text" class="pv-input" style="width: 100%;" placeholder="Contoh: Analisis Statistik Anova Data Kelompok Uji" @bind="_newTaskTitle" />
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.375rem;">Prioritas</label>
                <select class="pv-input" style="width: 100%;" @bind="_newTaskPriority">
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
