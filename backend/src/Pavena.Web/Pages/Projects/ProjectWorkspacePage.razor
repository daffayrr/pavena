{
    <div class="pv-modal-backdrop" @onclick="() => _showMilestoneModal = false">
        <div class="pv-modal-dialog" @onclick:stopPropagation>
            <h3 style="margin-top: 0; font-size: 1.25rem;">Tambah Tonggak Capaian (Milestone)</h3>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.375rem;">Judul Capaian</label>
